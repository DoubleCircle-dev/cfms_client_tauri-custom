{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CFMS Client",
  "version": "0.57.0-custom-0.2",
  "identifier": "org.crpteam.cfms-client-tauri",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1909",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "CFMS Client",
        "width": 1280,
        "height": 720,
        "create": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/avatars/**"
        ]
      }
    }
  },
  "plugins": {
    "background-service": {
      "androidForegroundServiceTypes": [
        "dataSync"
      ],
      "androidNotificationChannelId": "cfms_background_service",
      "androidNotificationChannelName": "CFMS Background Service",
      "androidShowStopAction": false
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg1OTQ1RTE4ODZDRjAyRDkKUldUWkFzK0dHRjZVaFk2aEo5cE9kaVk3UVFBUXAzU2Z0bXdPSVk1VWQrNUlvcG1GT0loSE9wNFcK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "android": {
      "autoIncrementVersionCode": false,
      "minSdkVersion": 28
    },
    "targets": "all",
    "resources": {
      "ca": "ca"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "version": "0.57.0.2"
      }
    }
  }
}
